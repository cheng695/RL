+-def extract_arxiv_links(locations: list[dict[str, Any]]) -> tuple[str | None, str | None, str | None]:
+-    for location in locations:
+-        landing = location.get("landing_page_url") or ""
+-        pdf_url = location.get("pdf_url")
+-        if "arxiv.org/abs/" in landing:
+-            arxiv_id = landing.rsplit("/", 1)[-1]
+-            arxiv_id = arxiv_id.replace("v1", "").replace("v2", "").replace("v3", "")
+-            pdf_url = pdf_url or f"https://arxiv.org/pdf/{arxiv_id}.pdf"
+-            return arxiv_id, landing.replace("http://", "https://"), pdf_url
+-    return None, None, None
