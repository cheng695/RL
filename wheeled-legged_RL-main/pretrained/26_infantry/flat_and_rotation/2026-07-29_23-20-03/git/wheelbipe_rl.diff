+-    "title": "Solving Vision Tasks with Simple Photoreceptors Instead of Cameras",
+-    "openalex_id": "https://openalex.org/W4399795462",
+-    "relevance_score": 2.1215944,
+-    "publication_date": "2024-06-17",
+-    "publication_year": 2024,
