+-METRIC_PATTERNS = {
+-    "iteration": re.compile(r"Learning iteration\s+(\d+)/(\d+)"),
+-    "timesteps": re.compile(r"Total timesteps:\s+(\d+)"),
+-    "reward": re.compile(r"Mean reward:\s+([-+0-9.]+)"),
+-    "episode_length": re.compile(r"Mean episode length:\s+([-+0-9.]+)"),
+-    "terminate": re.compile(r"Episode/Reset/terminate:\s+([-+0-9.]+)"),
+-    "timeout": re.compile(r"Episode/Reset/time_out:\s+([-+0-9.]+)"),
+-    "curriculum_stage": re.compile(r"Curriculum/track_height_progression/stage:\s+([-+0-9.]+)"),
+-    "reconstruction": re.compile(r"Mean reconstruction loss:\s+([-+0-9.]+)"),
+-    "vel_estimation": re.compile(r"Mean vel_estimation loss:\s+([-+0-9.]+)"),
+-    "estimation": re.compile(r"Mean estimation loss:\s+([-+0-9.]+)"),
+-    "swap": re.compile(r"Mean swap loss:\s+([-+0-9.]+)"),
+-}
+-
+-
+-def now() -> str:
+-    return dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S %Z")
+-
+-
+-def bounded_tail(path: Path, max_bytes: int = 262_144) -> str:
+-    if not path.exists():
+-        return ""
+-    with path.open("rb") as f:
+-        f.seek(0, os.SEEK_END)
+-        size = f.tell()
+-        f.seek(max(0, size - max_bytes), os.SEEK_SET)
+-        return f.read().decode("utf-8", errors="ignore")
+-
+-
+-def latest_runtime_log(spec: RunSpec) -> Path | None:
+-    logs = sorted(spec.exp_dir.glob(spec.runtime_glob), key=lambda p: p.stat().st_mtime if p.exists() else 0)
+-    return logs[-1] if logs else None
+-
+-
+-def experiment_done(spec: RunSpec) -> bool:
+-    spec_path = spec.exp_dir / "spec.yaml"
+-    if not spec_path.exists():
+-        return False
+-    for line in spec_path.read_text(encoding="utf-8", errors="ignore").splitlines():
+-        if line.strip().startswith("status:"):
+-            return line.split(":", 1)[1].strip().strip("\"'") == "done"
+-    return False
+-
+-
+-def parse_metrics(path: Path | None) -> dict[str, str | int | None]:
+-    if path is None:
+-        return {}
+-    text = bounded_tail(path)
+-    if not text:
+-        return {}
+-    iter_matches = list(METRIC_PATTERNS["iteration"].finditer(text))
+-    if not iter_matches:
+-        return {}
+-    last_iter = iter_matches[-1]
+-    block = text[last_iter.start():]
+-    metrics: dict[str, str | int | None] = {
+-        "iteration": int(last_iter.group(1)),
+-        "total": int(last_iter.group(2)),
+-    }
+-    for key, pattern in METRIC_PATTERNS.items():
+-        if key == "iteration":
+-            continue
+-        matches = list(pattern.finditer(block))
+-        if matches:
+-            metrics[key] = matches[-1].group(1)
+-    return metrics
+-
+-
+-def running_pids(spec: RunSpec) -> list[int]:
+-    result = subprocess.run(["ps", "-eo", "pid=,cmd="], text=True, capture_output=True, check=False)
+-    pids: list[int] = []
+-    for line in result.stdout.splitlines():
+-        line = line.strip()
+-        if not line:
+-            continue
+-        pid_s, _, cmd = line.partition(" ")
+-        if not cmd.startswith(PYTHON + " ") or "scripts/rsl_rl/train.py" not in cmd:
+-            continue
+-        if any(task in cmd for task in spec.task_aliases):
+-            pids.append(int(pid_s))
+-    return pids
+-
+-
+-def gpu_status() -> str:
+-    result = subprocess.run(
+-        [
+-            "nvidia-smi",
+-            "--query-gpu=memory.used,memory.total,utilization.gpu",
+-            "--format=csv,noheader,nounits",
+-        ],
+-        text=True,
+-        capture_output=True,
+-        check=False,
+-    )
+-    return result.stdout.strip().replace(", ", "/") if result.stdout.strip() else "unknown"
+-
+-
+-def latest_checkpoint(spec: RunSpec) -> tuple[int | None, Path | None]:
+-    if not spec.log_root.exists():
+-        return None, None
+-    run_dirs = sorted(
+-        [path for path in spec.log_root.iterdir() if path.is_dir()],
+-        key=lambda path: path.stat().st_mtime if path.exists() else 0,
+-        reverse=True,
+-    )
+-    for run_dir in run_dirs:
+-        checkpoints: list[tuple[int, float, Path]] = []
+-        for path in run_dir.glob("model_*.pt"):
+-            match = re.search(r"model_(\d+)\.pt$", path.name)
+-            if match:
+-                checkpoints.append((int(match.group(1)), path.stat().st_mtime, path))
+-        if checkpoints:
+-            iteration, _, path = max(checkpoints, key=lambda item: (item[0], item[1]))
+-            return iteration, path
+-    return None, None
+-
+-
+-def shell_join(parts: list[str]) -> str:
+-    return " ".join(shlex.quote(part) for part in parts)
+-
+-
+-def restart(spec: RunSpec, checkpoint_iter: int | None, checkpoint_path: Path | None, log_file: Path) -> str:
+-    timestamp = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
+-    if checkpoint_iter is not None and checkpoint_path is not None and checkpoint_iter > 0:
+-        remaining = spec.final_total - (checkpoint_iter + 1)
+-        if remaining <= 0:
+-            return f"{spec.name} checkpoint 已达目标附近，不重启: {checkpoint_path}"
+-        task = spec.restart_task
+-        run_name = f"{spec.run_name_prefix}_auto_resume_{checkpoint_iter}_to_{spec.final_total}_no_curriculum"
+-        runtime_log = spec.exp_dir / "runtime" / f"auto_resume_{checkpoint_iter}_to_{spec.final_total}_{timestamp}.log"
+-        args = [
+-            PYTHON,
+-            "scripts/rsl_rl/train.py",
+-            "--task",
+-            task,
+-            "--num_envs",
+-            str(spec.num_envs),
+-            "--max_iterations",
+-            str(remaining),
+-            "--run_name",
+-            run_name,
+-            "--checkpoint",
+-            str(checkpoint_path.relative_to(ROOT)),
+-            "--resume_training",
+-            "--device=cuda:0",
+-            "--headless",
+-        ]
+-    else:
+-        task = spec.restart_task_from_scratch
+-        run_name = f"{spec.run_name_prefix}_auto_restart_from_scratch"
+-        runtime_log = spec.exp_dir / "runtime" / f"auto_restart_from_scratch_{timestamp}.log"
+-        args = [
+-            PYTHON,
+-            "scripts/rsl_rl/train.py",
+-            "--task",
+-            task,
+-            "--num_envs",
+-            str(spec.num_envs),
+-            "--max_iterations",
+-            str(spec.final_total),
+-            "--run_name",
+-            run_name,
+-            "--device=cuda:0",
+-            "--headless",
+-        ]
+-
+-    runtime_log.parent.mkdir(parents=True, exist_ok=True)
+-    session = f"{spec.session_prefix}_{timestamp}"
+-    command = f"cd {shlex.quote(str(ROOT))} && {shell_join(args)} 2>&1 | tee {shlex.quote(str(runtime_log.relative_to(ROOT)))}"
+-    subprocess.run(["tmux", "new-session", "-d", "-s", session, command], check=False)
+-    return f"{spec.name} 已重启: session={session}, log={runtime_log.relative_to(ROOT)}"
+-
+-
+-def status_line(spec: RunSpec) -> tuple[str, bool]:
+-    pids = running_pids(spec)
+-    metrics = parse_metrics(latest_runtime_log(spec))
+-    ckpt_iter, ckpt_path = latest_checkpoint(spec)
+-    iter_text = "iter=?"
+-    if "iteration" in metrics and "total" in metrics:
+-        iter_text = f"iter={metrics['iteration']}/{metrics['total']}"
+-    values = [
+-        iter_text,
+-        f"reward={metrics.get('reward', '?')}",
+-        f"len={metrics.get('episode_length', '?')}",
+-        f"term={metrics.get('terminate', '?')}",
+-        f"timeout={metrics.get('timeout', '?')}",
+-    ]
+-    if "reconstruction" in metrics:
+-        values.append(f"recon={metrics.get('reconstruction')}")
+-    if "vel_estimation" in metrics:
+-        values.append(f"vel={metrics.get('vel_estimation')}")
+-    if "estimation" in metrics:
+-        values.append(f"est={metrics.get('estimation')}")
+-    if "swap" in metrics:
+-        values.append(f"swap={metrics.get('swap')}")
+-    if "curriculum_stage" in metrics:
+-        values.append(f"cur={metrics.get('curriculum_stage')}")
+-    values.append(f"ckpt={ckpt_path.relative_to(ROOT) if ckpt_path else '?'}")
+-
+-    if pids:
+-        return f"[{spec.name}] RUNNING pids={','.join(map(str, pids))} " + " ".join(values), False
+-
+-    completed = isinstance(metrics.get("iteration"), int) and int(metrics["iteration"]) >= spec.final_total - 1
+-    if completed:
+-        return f"[{spec.name}] COMPLETE " + " ".join(values), False
+-    return f"[{spec.name}] MISSING " + " ".join(values), True
+-
+-
+-def poll_once(
+-    log_file: Path | None,
+-    autorestart: bool,
+-    skip_done: bool,
+-    selected_names: set[str] | None = None,
+-) -> None:
+-    lines = [f"===== light poll {now()} gpu={gpu_status()} ====="]
+-    for spec in RUNS:
+-        if selected_names is not None and spec.name not in selected_names:
+-            continue
+-        if skip_done and experiment_done(spec):
+-            continue
+-        line, should_restart = status_line(spec)
+-        lines.append(line)
+-        if should_restart and autorestart:
+-            ckpt_iter, ckpt_path = latest_checkpoint(spec)
+-            lines.append("[restart] " + restart(spec, ckpt_iter, ckpt_path, log_file))
+-    output = "\n".join(lines)
+-    print(output, flush=True)
+-    if log_file is not None:
+-        with log_file.open("a", encoding="utf-8") as f:
+-            f.write(output + "\n")
+-
+-
+-def main() -> None:
+-    parser = argparse.ArgumentParser()
+-    parser.add_argument("--interval", type=int, default=900)
+-    parser.add_argument("--once", action="store_true")
+-    parser.add_argument("--no-autorestart", action="store_true")
+-    parser.add_argument("--no-log", action="store_true")
+-    parser.add_argument("--skip-done", action="store_true")
+-    parser.add_argument(
+-        "--names",
+-        type=str,
+-        default="",
+-        help="Comma-separated RunSpec names to poll/restart, for example exp9_mood_delay_gru,exp10_mood_pose_cmd.",
+-    )
+-    parser.add_argument("--log", type=Path, default=RUNTIME_ROOT / "light_watchdog_latest.log")
+-    args = parser.parse_args()
+-
+-    log_file = None if args.no_log else args.log
+-    if log_file is not None:
+-        log_file.parent.mkdir(parents=True, exist_ok=True)
+-    selected_names = {name.strip() for name in args.names.split(",") if name.strip()} or None
+-    poll_once(
+-        log_file,
+-        autorestart=not args.no_autorestart,
+-        skip_done=args.skip_done,
+-        selected_names=selected_names,
+-    )
+-    if args.once:
+-        return
+-    while True:
+-        time.sleep(args.interval)
+-        poll_once(
+-            log_file,
+-            autorestart=not args.no_autorestart,
+-            skip_done=args.skip_done,
+-            selected_names=selected_names,
+-        )
+-
+-
+-if __name__ == "__main__":
+-    main()
