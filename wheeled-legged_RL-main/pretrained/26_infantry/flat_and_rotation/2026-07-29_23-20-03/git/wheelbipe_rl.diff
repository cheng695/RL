++    def _shape_penalty(
++        self,
++        value: torch.Tensor,
++        mode: str,
++        *,
++        square_sigma: float = 1.0,
++    ) -> torch.Tensor:
++        mode = mode.lower()
++        if mode == "binary":
++            return (value > 0.0).float()
++        if mode == "l1":
++            return value
++        if mode == "l2":
++            return square_sigma * torch.square(value)
++        raise ValueError(f"Unsupported airborne reward penalty mode: {mode}")
++
