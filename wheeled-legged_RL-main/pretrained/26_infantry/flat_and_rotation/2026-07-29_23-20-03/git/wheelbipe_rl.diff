+-+            contact_mask,  # 2    
+-+            self.has_jumped.unsqueeze(1),
+-+            
+-+        ), dim=-1)#5 12 12 12 12 3 3 3 1 1 2 2 =68
+-+        # print("self.privileged_obs_buf",self.privileged_obs_buf.shape)
+-+        q = (self.dof_pos - self.default_dof_pos) * self.obs_scales.dof_pos
