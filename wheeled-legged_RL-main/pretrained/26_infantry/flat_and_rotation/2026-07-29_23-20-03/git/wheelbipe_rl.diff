+-#!/usr/bin/env python3
+-from __future__ import annotations
+-
+-import argparse
+-import json
+-import shutil
+-import subprocess
+-import sys
+-from pathlib import Path
+-
+-import torch
+-import torch.nn as nn
+-
+-
+-ROOT = Path(__file__).resolve().parents[3]
+-BENCH_DIR = Path(__file__).resolve().parent
+-MODELS_DIR = BENCH_DIR / "models"
+-
+-V14FLAT_CHECKPOINT = ROOT / "logs/rsl_rl/wheelbipe_v14_flat_direct/2026-04-23_02-24-03/model_26999.pt"
+-DELAY_GRU_ONNX = ROOT / "experiments/v14_flat/009_mood_delay_gru/checkpoints/exported/policy.onnx"
+-JUMP_RNN_ONNX = ROOT / "experiments/v14_flat/016_mood_mt_jump_rnn/checkpoints/exported/policy.onnx"
+-MOE_CHECKPOINT = (
+-    ROOT
+-    / "experiments/v14_flat/021_mood/checkpoints/"
+-    "exp21_mood_mt_moe_resume_5000_to10000_reimpl_20260505_2310_model_9999.pt"
+-)
+-
+-
+-def _load_onnx():
+-    import onnx
+-
+-    return onnx
+-
+-
+-def _optional_ort_validate(onnx_path: Path, torch_model: nn.Module, sample: torch.Tensor) -> float | None:
+-    try:
+-        import numpy as np
+-        import onnxruntime as ort
+-    except Exception:
+-        return None
+-    session = ort.InferenceSession(str(onnx_path), providers=["CPUExecutionProvider"])
+-    input_name = session.get_inputs()[0].name
+-    ort_out = session.run(None, {input_name: sample.numpy()})[0]
+-    with torch.no_grad():
+-        torch_out = torch_model(sample).numpy()
+-    return float(np.max(np.abs(torch_out - ort_out)))
+-
+-
+-def export_v14flat_mlp(output_path: Path) -> dict:
+-    state = torch.load(V14FLAT_CHECKPOINT, map_location="cpu", weights_only=False)
+-    state_dict = state.get("model_state_dict", state)
+-    actor_weight_keys = sorted(
+-        [key for key in state_dict.keys() if key.startswith("actor.") and key.endswith(".weight")],
+-        key=lambda key: int(key.split(".")[1]),
+-    )
+-    if not actor_weight_keys:
+-        raise RuntimeError(f"No actor weights found in {V14FLAT_CHECKPOINT}")
+-
+-    layers: list[nn.Module] = []
+-    for index, weight_key in enumerate(actor_weight_keys):
+-        weight = state_dict[weight_key]
+-        layers.append(nn.Linear(int(weight.shape[1]), int(weight.shape[0])))
+-        if index != len(actor_weight_keys) - 1:
+-            layers.append(nn.ELU())
+-    actor = nn.Sequential(*layers).eval()
+-    actor.load_state_dict(
+-        {
+-            key.removeprefix("actor."): value
+-            for key, value in state_dict.items()
+-            if key.startswith("actor.")
+-        },
+-        strict=True,
+-    )
+-
+-    output_path.parent.mkdir(parents=True, exist_ok=True)
+-    obs_dim = int(state_dict[actor_weight_keys[0]].shape[1])
+-    action_dim = int(state_dict[actor_weight_keys[-1]].shape[0])
+-    sample = torch.zeros(1, obs_dim, dtype=torch.float32)
+-    torch.onnx.export(
+-        actor,
+-        sample,
+-        str(output_path),
+-        export_params=True,
+-        opset_version=17,
+-        do_constant_folding=True,
+-        input_names=["obs"],
+-        output_names=["actions"],
+-    )
+-    onnx = _load_onnx()
+-    onnx.checker.check_model(onnx.load(str(output_path)))
+-    meta = {
+-        "id": "v14flat_mlp",
+-        "output": str(output_path),
+-        "source": str(V14FLAT_CHECKPOINT),
+-        "obs_dim": obs_dim,
+-        "action_dim": action_dim,
+-        "torch_vs_onnx_max_abs_error": _optional_ort_validate(output_path, actor, sample),
+-    }
+-    output_path.with_suffix(".json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
+-    return meta
+-
+-
+-def copy_existing(src: Path, dst: Path, model_id: str) -> dict:
+-    if not src.exists():
+-        raise FileNotFoundError(src)
+-    dst.parent.mkdir(parents=True, exist_ok=True)
+-    shutil.copy2(src, dst)
+-    onnx = _load_onnx()
+-    onnx.checker.check_model(onnx.load(str(dst)))
+-    meta = {"id": model_id, "output": str(dst), "source": str(src)}
+-    dst.with_suffix(".json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
+-    return meta
+-
+-
+-def export_mood_moe(output_path: Path) -> dict:
+-    cmd = [
+-        sys.executable,
+-        str(ROOT / "scripts/rsl_rl/export_mood_moe_onnx.py"),
+-        "--task",
+-        "Robotics-Wheelbipe-V14-Mood-MT-MoE-Play-v0",
+-        "--checkpoint",
+-        str(MOE_CHECKPOINT),
+-        "--output",
+-        str(output_path),
+-    ]
+-    subprocess.run(cmd, cwd=str(ROOT), check=True)
+-    onnx = _load_onnx()
+-    onnx.checker.check_model(onnx.load(str(output_path)))
+-    meta_path = output_path.with_suffix(".json")
+-    return json.loads(meta_path.read_text(encoding="utf-8")) if meta_path.exists() else {"output": str(output_path)}
+-
+-
+-def main() -> None:
+-    parser = argparse.ArgumentParser(description="Prepare fixed ONNX models for V14 flat benchmark.")
+-    parser.add_argument("--skip_moe_export", action="store_true", help="Do not export 021 Mood MoE.")
+-    args = parser.parse_args()
+-
+-    MODELS_DIR.mkdir(parents=True, exist_ok=True)
+-    report = {
+-        "v14flat_mlp": export_v14flat_mlp(MODELS_DIR / "v14flat_mlp.onnx"),
+-        "delay_gru_009": copy_existing(DELAY_GRU_ONNX, MODELS_DIR / "delay_gru_009.onnx", "delay_gru_009"),
+-        "jump_rnn_016": copy_existing(JUMP_RNN_ONNX, MODELS_DIR / "jump_rnn_016.onnx", "jump_rnn_016"),
+-    }
+-    if not args.skip_moe_export:
+-        report["mood_moe_021"] = export_mood_moe(MODELS_DIR / "mood_moe_021.onnx")
+-    (BENCH_DIR / "reports").mkdir(parents=True, exist_ok=True)
+-    (BENCH_DIR / "reports/prepare_models.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
+-    print(json.dumps(report, indent=2))
+-
+-
+-if __name__ == "__main__":
+-    main()
