+-def iso_to_datetime(value: str | None) -> datetime | None:
+-    if not value:
+-        return None
+-    try:
+-        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
+-        if dt.tzinfo is None:
+-            dt = dt.replace(tzinfo=UTC)
+-        return dt
+-    except ValueError:
+-        return None
