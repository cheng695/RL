+-def normalize_topic(topic: str) -> str:
+-    topic = topic.strip()
+-    replacements = {
+-        "单policy": "single policy",
+-        "单一policy": "single policy",
+-        "多任务": "multi-task",
+-        "强化学习": "reinforcement learning",
+-        "机器人": "robot",
+-        "粗糙地形": "rough terrain",
+-        "运动任务": "locomotion tasks",
+-        "实现": "implementation",
+-        "训练": "training",
+-    }
+-    for src, dst in replacements.items():
+-        topic = topic.replace(src, dst)
+-    return re.sub(r"\s+", " ", topic)
+-
+-
+-def build_queries(topic: str, repo_keywords: list[str]) -> list[str]:
+-    topic = normalize_topic(topic).lower()
+-    queries: list[str] = [topic]
+-    merged_context = " ".join([topic, *repo_keywords]).lower()
+-    for terms, query in TOPIC_HINT_RULES:
+-        if any(term in merged_context for term in terms):
+-            queries.append(query)
+-    if "rough terrain locomotion" in merged_context or "rough terrain locomotion" in repo_keywords:
+-        queries.append("generalist locomotion rough terrain robot")
+-    if "task-conditioned single policy" in repo_keywords:
+-        queries.append("task-conditioned reinforcement learning robot locomotion")
+-    if "command-conditioned control" in repo_keywords:
+-        queries.append("command-conditioned locomotion policy robot")
+-    if "curriculum learning" in repo_keywords:
+-        queries.append("curriculum reinforcement learning legged robot locomotion")
+-    deduped: list[str] = []
+-    seen: set[str] = set()
+-    for query in queries:
+-        query = re.sub(r"\s+", " ", query.strip())
+-        if not query or query in seen:
+-            continue
+-        seen.add(query)
+-        deduped.append(query)
+-    return deduped[:8]
+-
