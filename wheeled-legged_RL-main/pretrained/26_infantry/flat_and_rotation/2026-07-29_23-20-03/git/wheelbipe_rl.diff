+-def slugify(text: str, max_len: int = 80) -> str:
+-    text = text.strip().lower()
+-    text = re.sub(r"[^\w\s-]", "", text)
+-    text = re.sub(r"[-\s]+", "-", text).strip("-")
+-    return text[:max_len] or "paper-run"
+-
