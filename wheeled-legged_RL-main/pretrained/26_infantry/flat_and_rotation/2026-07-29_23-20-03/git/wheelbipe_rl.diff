+-def gather_claim_sentences(text: str, max_items: int = 8) -> list[str]:
+-    text = re.sub(r"\s+", " ", text)
+-    sentences = re.split(r"(?<=[.!?])\s+", text)
+-    patterns = (
+-        r"\bwe propose\b",
+-        r"\bwe present\b",
+-        r"\bour (method|approach|policy|framework|contribution|contributions)\b",
+-        r"\bnovel\b",
+-        r"\bfirst\b",
+-        r"\bunified\b",
+-        r"\bgeneralist\b",
+-        r"\btask-conditioned\b",
+-        r"\bmixture of experts\b",
+-    )
+-    hits: list[str] = []
+-    for sentence in sentences:
+-        if len(sentence) < 40 or len(sentence) > 320:
+-            continue
+-        if any(re.search(pattern, sentence, flags=re.IGNORECASE) for pattern in patterns):
+-            normalized = sentence.strip()
+-            if normalized not in hits:
+-                hits.append(normalized)
+-        if len(hits) >= max_items:
+-            break
+-    return hits
+-
+-
+-def split_text_blocks(text: str) -> list[str]:
+-    text = text.replace("\r\n", "\n")
+-    blocks = re.split(r"\n\s*\n+", text)
+-    cleaned_blocks: list[str] = []
+-    for block in blocks:
+-        normalized = re.sub(r"[ \t]+", " ", block.strip())
+-        normalized = re.sub(r"\n{2,}", "\n", normalized)
+-        if len(normalized) >= 40:
+-            cleaned_blocks.append(normalized)
+-    return cleaned_blocks
+-
+-
+-def clip_text(text: str, max_chars: int) -> str:
+-    compact = re.sub(r"\s+", " ", text).strip()
+-    if len(compact) <= max_chars:
+-        return compact
+-    return compact[: max_chars - 3].rstrip() + "..."
+-
+-
+-def is_reference_like_block(text: str) -> bool:
+-    blob = text.lower().strip()
+-    if not blob:
+-        return False
+-    if blob.startswith("references"):
+-        return True
+-    if re.match(r"^\[\d+\]", blob):
+-        return True
+-    if blob.startswith("table ") and "doi" in blob and "url" in blob:
+-        return True
+-    citation_markers = sum(blob.count(token) for token in (" arxiv", "doi:", " url ", "http://", "https://"))
+-    numbered_citations = len(re.findall(r"\[\d+\]", blob))
+-    if numbered_citations >= 2 and citation_markers >= 1:
+-        return True
+-    if blob.count("et al.") >= 2 and citation_markers >= 1:
+-        return True
+-    return False
+-
+-
+-def build_thematic_excerpts(text: str) -> dict[str, list[str]]:
+-    blocks = split_text_blocks(text)
+-    if not blocks:
+-        return {}
+-
+-    excerpts: dict[str, list[str]] = {}
+-    used_snippets: set[str] = set()
+-    for label, keywords in THEMATIC_EXCERPT_RULES:
+-        label_hits: list[str] = []
+-        for block in blocks:
+-            if is_reference_like_block(block):
+-                continue
+-            blob = block.lower()
+-            if not any(keyword in blob for keyword in keywords):
+-                continue
+-            snippet = clip_text(block, max_chars=MAX_THEMATIC_SNIPPET_CHARS)
+-            marker = snippet.lower()
+-            if marker in used_snippets:
+-                continue
+-            label_hits.append(snippet)
+-            used_snippets.add(marker)
+-            if len(label_hits) >= MAX_THEMATIC_SNIPPETS_PER_TOPIC:
+-                break
+-        if label_hits:
+-            excerpts[label] = label_hits
+-    return excerpts
+-
+-
+-def slice_text_for_prompt(text: str) -> str:
+-    cleaned = re.sub(r"\n{3,}", "\n\n", text)
+-    cleaned = cleaned.strip()
+-    if len(cleaned) <= MAX_TEXT_CHARS:
+-        return cleaned
+-
+-    head_chars = min(16000, MAX_TEXT_CHARS)
+-    tail_chars = min(8000, max(MAX_TEXT_CHARS - head_chars - 200, 0))
+-    parts = [f"[开头摘录]\n{cleaned[:head_chars].rstrip()}"]
+-    if tail_chars > 0:
+-        parts.append(f"[结尾摘录]\n{cleaned[-tail_chars:].lstrip()}")
+-    return "\n\n".join(parts)[:MAX_TEXT_CHARS]
+-
