+-def load_text_files(repo_root: Path) -> list[tuple[Path, str]]:
+-    allow_suffixes = {".py", ".md", ".yaml", ".yml", ".toml", ".json"}
+-    skip_parts = {
+-        ".git",
+-        ".idea",
+-        ".vscode",
+-        "__pycache__",
+-        "build",
+-        "dist",
+-        "pretrained",
+-        "papers",
+-        "logs",
+-        ".cursor",
+-    }
+-    items: list[tuple[Path, str]] = []
+-    for path in repo_root.rglob("*"):
+-        if not path.is_file():
+-            continue
+-        if path.suffix.lower() not in allow_suffixes:
+-            continue
+-        if any(part in skip_parts for part in path.parts):
+-            continue
+-        try:
+-            text = path.read_text(encoding="utf-8", errors="ignore")
+-        except OSError:
+-            continue
+-        if text:
+-            items.append((path, text))
+-    return items
+-
+-
+-def extract_repo_signals(repo_root: Path) -> dict[str, Any]:
+-    files = load_text_files(repo_root)
+-    signal_hits: dict[str, list[str]] = defaultdict(list)
+-    raw_token_counter: Counter[str] = Counter()
+-    for path, text in files:
+-        rel_path = path.relative_to(repo_root).as_posix()
+-        raw_token_counter.update(
+-            token.lower()
+-            for token in re.findall(r"[a-zA-Z][a-zA-Z0-9_-]{2,}", rel_path)
+-            if token.lower() not in STOPWORDS
+-        )
+-        for token in re.findall(r"[a-zA-Z][a-zA-Z0-9_-]{2,}", text):
+-            token = token.lower()
+-            if token in STOPWORDS or len(token) < 4:
+-                continue
+-            raw_token_counter[token] += 1
+-        for pattern, keyword, _desc in SIGNAL_RULES:
+-            matches = list(re.finditer(pattern, text, flags=re.IGNORECASE))
+-            if not matches:
+-                continue
+-            for match in matches[:3]:
+-                line_no = text[: match.start()].count("\n") + 1
+-                snippet = text[max(0, match.start() - 60) : match.end() + 120].replace("\n", " ").strip()
+-                evidence = f"{rel_path}:{line_no} - {snippet}"
+-                signal_hits[keyword].append(evidence)
+-    repo_signals: list[RepoSignal] = []
+-    for _pattern, keyword, description in SIGNAL_RULES:
+-        evidence = signal_hits.get(keyword, [])
+-        if not evidence:
+-            continue
+-        repo_signals.append(
+-            RepoSignal(
+-                keyword=keyword,
+-                count=len(evidence),
+-                description=description,
+-                evidence=evidence[:5],
+-            )
+-        )
+-    repo_signals.sort(key=lambda item: (-item.count, item.keyword))
+-    top_tokens = [token for token, _count in raw_token_counter.most_common(25)]
+-    return {
+-        "signals": [asdict(item) for item in repo_signals],
+-        "keywords": [item.keyword for item in repo_signals[:8]],
+-        "raw_top_tokens": top_tokens,
+-        "scanned_files": len(files),
+-    }
