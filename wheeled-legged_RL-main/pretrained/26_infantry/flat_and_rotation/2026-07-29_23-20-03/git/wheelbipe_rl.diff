+-        ),
+-    }
+-    last_error: Exception | None = None
+-    for attempt in range(1, OPENALEX_MAX_RETRIES + 1):
+-        try:
+-            response = session.get(OPENALEX_WORKS_URL, params=params, timeout=REQUEST_TIMEOUT)
+-            response.raise_for_status()
+-            payload = response.json()
+-            return payload.get("results", [])
+-        except requests.exceptions.RequestException as exc:
+-            status_code = exc.response.status_code if exc.response is not None else None
+-            retryable = status_code in {429, 500, 502, 503, 504} or status_code is None
+-            last_error = exc
+-            if not retryable or attempt >= OPENALEX_MAX_RETRIES:
+-                raise
+-            sleep_seconds = OPENALEX_RETRY_BACKOFF_SECONDS * attempt
+-            print(
+-                f"[openalex] query={query!r} page={page} attempt={attempt} failed with {type(exc).__name__}; retrying in {sleep_seconds:.1f}s",
+-                file=sys.stderr,
+-            )
+-            time.sleep(sleep_seconds)
+-    if last_error is not None:
+-        raise last_error
+-    return []
+-
+-
+-def collect_candidates(
+-    session: requests.Session,
+-    queries: list[str],
+-    max_pages_per_query: int,
+-    page_size: int,
+-    mailto: str,
+-) -> list[PaperCandidate]:
+-    merged: dict[str, PaperCandidate] = {}
+-    for query in queries:
+-        for page in range(1, max_pages_per_query + 1):
+-            results = openalex_search(session, query=query, page=page, page_size=page_size, mailto=mailto)
+-            if not results:
+-                break
+-            for item in results:
+-                arxiv_id, arxiv_abs_url, arxiv_pdf_url = extract_arxiv_links(item.get("locations") or [])
+-                if not arxiv_id:
+-                    continue
+-                openalex_id = item["id"]
+-                abstract = reconstruct_abstract(item.get("abstract_inverted_index"))
+-                concepts = [concept["display_name"] for concept in item.get("concepts") or [] if concept.get("score", 0) >= 0.3]
+-                authors = [auth["author"]["display_name"] for auth in item.get("authorships") or [] if auth.get("author")]
+-                keyword_hits = [token for token in re.findall(r"[a-zA-Z][a-zA-Z-]{3,}", query.lower()) if token not in STOPWORDS]
+-                candidate = PaperCandidate(
+-                    title=item.get("display_name") or item.get("title") or "Untitled",
+-                    openalex_id=openalex_id,
+-                    relevance_score=float(item.get("relevance_score") or 0.0),
+-                    publication_date=item.get("publication_date"),
+-                    publication_year=item.get("publication_year"),
+-                    cited_by_count=int(item.get("cited_by_count") or 0),
+-                    doi=item.get("doi"),
+-                    authors=authors[:10],
+-                    arxiv_id=arxiv_id,
+-                    arxiv_abs_url=arxiv_abs_url,
+-                    arxiv_pdf_url=arxiv_pdf_url,
+-                    abstract=abstract,
+-                    concepts=concepts[:8],
+-                    keyword_hits=keyword_hits,
+-                    raw=item,
+-                )
+-                existing = merged.get(arxiv_id)
+-                if existing is None:
+-                    merged[arxiv_id] = candidate
+-                else:
+-                    existing.relevance_score = max(existing.relevance_score, candidate.relevance_score)
+-                    existing.cited_by_count = max(existing.cited_by_count, candidate.cited_by_count)
+-                    for term in candidate.keyword_hits:
+-                        if term not in existing.keyword_hits:
+-                            existing.keyword_hits.append(term)
+-            time.sleep(0.2)
+-    return list(merged.values())
+-
