+-    "title": "Universal Morphology Control via Contextual Modulation",
+-    "openalex_id": "https://openalex.org/W4321649089",
+-    "relevance_score": 4.4913034,
+-    "publication_date": "2023-02-22",
+-    "publication_year": 2023,
