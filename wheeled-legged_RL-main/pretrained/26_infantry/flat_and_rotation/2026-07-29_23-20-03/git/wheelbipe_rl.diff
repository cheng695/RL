+-    "doi": "https://doi.org/10.1038/s41598-023-38259-7",
+-    "authors": [
+-      "Michel Aractingi",
+-      "Pierre‐Alexandre Léziart",
+-      "Thomas Flayols",
+-      "Julien Perez",
