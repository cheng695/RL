+-    "title": "QuadrupedGPT: Towards a Versatile Quadruped Agent in Open-ended Worlds",
+-    "openalex_id": "https://openalex.org/W4400024379",
+-    "relevance_score": 4.297823,
+-    "publication_date": "2024-06-24",
+-    "publication_year": 2024,
