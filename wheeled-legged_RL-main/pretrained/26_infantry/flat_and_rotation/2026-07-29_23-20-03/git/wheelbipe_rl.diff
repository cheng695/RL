+-def enrich_topic_matches(candidates: list[PaperCandidate], topic: str, repo_keywords: list[str]) -> dict[str, tuple[str, ...]]:
+-    anchor_groups = build_anchor_groups(topic=topic, repo_keywords=repo_keywords)
+-    for candidate in candidates:
+-        blob = " ".join(
+-            filter(
+-                None,
+-                [
+-                    candidate.title.lower(),
+-                    (candidate.abstract or "").lower(),
+-                    " ".join(candidate.concepts).lower(),
+-                ],
+-            )
+-        )
+-        matches: list[str] = []
+-        for group_name, anchors in anchor_groups.items():
+-            if any(anchor in blob for anchor in anchors):
+-                matches.append(group_name)
+-        candidate.topic_matches = matches
+-    return anchor_groups
+-
