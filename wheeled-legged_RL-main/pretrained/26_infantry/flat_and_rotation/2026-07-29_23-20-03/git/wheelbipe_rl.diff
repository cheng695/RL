+-def build_anchor_groups(topic: str, repo_keywords: list[str]) -> dict[str, tuple[str, ...]]:
+-    merged = " ".join([topic.lower(), *repo_keywords]).lower()
+-    groups: dict[str, tuple[str, ...]] = {
+-        "robotics": (
+-            "robot",
+-            "robotic",
+-            "humanoid",
+-            "quadruped",
+-            "biped",
+-            "legged",
+-            "embodiment",
+-        ),
+-        "locomotion": (
+-            "locomotion",
+-            "legged",
+-            "quadruped",
+-            "humanoid",
+-            "gait",
+-            "terrain",
+-            "rough terrain",
+-            "wheeled",
+-            "wheel-legged",
+-            "bipedal",
+-            "walking",
+-            "parkour",
+-            "jump",
+-            "navigation and locomotion",
+-        ),
+-        "rl-control": (
+-            "reinforcement learning",
+-            "policy",
+-            "control",
+-            "actor-critic",
+-            "ppo",
+-            "mdp",
+-        ),
+-    }
+-    if any(term in merged for term in ("multi-task", "multitask", "single policy", "generalist", "unified", "task-conditioned")):
+-        groups["multitask"] = (
+-            "multi-task",
+-            "multitask",
+-            "multi skill",
+-            "multi-skill",
+-            "multi gait",
+-            "multi-gait",
+-            "single policy",
+-            "generalist",
+-            "unified",
+-            "task-conditioned",
+-            "task conditioned",
+-            "command-conditioned",
+-            "context-conditioned",
+-            "mixture of experts",
+-            "moe",
+-        )
+-    if any(term in merged for term in ("rough terrain", "terrain", "sub-terrain")):
+-        groups["terrain"] = (
+-            "rough terrain",
+-            "challenging terrain",
+-            "uneven terrain",
+-            "sub-terrain",
+-            "terrain-aware",
+-            "terrain",
+-        )
+-    if any(term in merged for term in ("jump", "airborne")):
+-        groups["jump"] = ("jump", "jumping", "airborne")
+-    return groups
