+-#!/usr/bin/env python3
+-from __future__ import annotations
+-
+-import argparse
+-import json
+-import time
+-from pathlib import Path
+-from typing import Any
+-
+-import numpy as np
+-import onnx
+-import yaml
+-
+-
+-BENCH_DIR = Path(__file__).resolve().parent
+-
+-
+-def _load_ort():
+-    try:
+-        import onnxruntime as ort
+-    except Exception as exc:
+-        raise RuntimeError(
+-            "onnxruntime is required. Install inside env_wheelbipe with: "
+-            "/home/robotlab/miniconda3/envs/env_wheelbipe/bin/python -m pip install onnxruntime"
+-        ) from exc
+-    return ort
+-
+-
+-def _rss_mb() -> float | None:
+-    try:
+-        import psutil
+-    except Exception:
+-        return None
+-    return psutil.Process().memory_info().rss / (1024.0 * 1024.0)
+-
+-
+-def _shape_dim(dim: Any, batch: int) -> int:
+-    if isinstance(dim, int) and dim > 0:
+-        return int(dim)
+-    return int(batch)
+-
+-
+-def _make_input(name: str, shape: list[Any], batch: int, rng: np.random.Generator) -> np.ndarray:
+-    resolved = [_shape_dim(dim, batch) for dim in shape]
+-    if "hidden" in name or name in {"h_in", "hidden_in", "actor_hidden_in", "critic_hidden_in"}:
+-        return np.zeros(resolved, dtype=np.float32)
+-    return rng.standard_normal(resolved, dtype=np.float32)
+-
+-
+-def _initializer_stats(path: Path) -> dict[str, int]:
+-    model = onnx.load(str(path))
+-    params = 0
+-    bytes_total = 0
+-    for initializer in model.graph.initializer:
+-        count = int(np.prod(initializer.dims)) if initializer.dims else 0
+-        params += count
+-        bytes_total += len(initializer.raw_data)
+-    return {"initializer_count": len(model.graph.initializer), "initializer_params": params, "initializer_bytes": bytes_total}
+-
+-
+-def _load_adjacent_meta(path: Path) -> dict[str, Any]:
+-    meta_path = path.with_suffix(".json")
+-    if not meta_path.exists():
+-        return {}
+-    try:
+-        return json.loads(meta_path.read_text(encoding="utf-8"))
+-    except Exception:
+-        return {}
+-
+-
+-def _run_model(model_id: str, path: Path, warmup: int, iterations: int, batch: int, seed: int) -> dict[str, Any]:
+-    ort = _load_ort()
+-    options = ort.SessionOptions()
+-    options.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
+-    options.intra_op_num_threads = 1
+-    options.inter_op_num_threads = 1
+-    rss_before = _rss_mb()
+-    session = ort.InferenceSession(str(path), sess_options=options, providers=["CPUExecutionProvider"])
+-    inputs = session.get_inputs()
+-    outputs = session.get_outputs()
+-    output_names = [out.name for out in outputs]
+-    rng = np.random.default_rng(seed)
+-    feed = {inp.name: _make_input(inp.name, list(inp.shape), batch, rng) for inp in inputs}
+-
+-    def run_once() -> list[np.ndarray]:
+-        values = session.run(None, feed)
+-        output_map = dict(zip(output_names, values))
+-        for input_name, output_name in (
+-            ("actor_hidden_in", "actor_hidden_out"),
+-            ("h_in", "h_out"),
+-            ("hidden_in", "hidden_out"),
+-        ):
+-            if input_name in feed and output_name in output_map:
+-                feed[input_name] = output_map[output_name]
+-        return values
+-
+-    for _ in range(warmup):
+-        run_once()
+-    latencies_ms = np.empty(iterations, dtype=np.float64)
+-    for index in range(iterations):
+-        start = time.perf_counter_ns()
+-        run_once()
+-        latencies_ms[index] = (time.perf_counter_ns() - start) / 1.0e6
+-    rss_after = _rss_mb()
+-    meta = _load_adjacent_meta(path)
+-    result = {
+-        "id": model_id,
+-        "path": str(path),
+-        "file_size_mb": path.stat().st_size / (1024.0 * 1024.0),
+-        "inputs": [{"name": inp.name, "shape": list(inp.shape), "type": inp.type} for inp in inputs],
+-        "outputs": [{"name": out.name, "shape": list(out.shape), "type": out.type} for out in outputs],
+-        **_initializer_stats(path),
+-        "warmup": warmup,
+-        "iterations": iterations,
+-        "batch": batch,
+-        "latency_ms": {
+-            "mean": float(np.mean(latencies_ms)),
+-            "p50": float(np.percentile(latencies_ms, 50)),
+-            "p95": float(np.percentile(latencies_ms, 95)),
+-            "p99": float(np.percentile(latencies_ms, 99)),
+-            "max": float(np.max(latencies_ms)),
+-        },
+-        "rss_delta_mb": None if rss_before is None or rss_after is None else rss_after - rss_before,
+-        "torch_vs_onnx_max_abs_error": meta.get("torch_vs_onnx_max_abs_error"),
+-    }
+-    return result
+-
+-
+-def _write_markdown(results: list[dict[str, Any]], output_path: Path) -> None:
+-    lines = [
+-        "# V14 ONNX CPU Benchmark",
+-        "",
+-        "| model | size MB | params | mean ms | p50 ms | p95 ms | p99 ms | max ms | rss delta MB | torch/onnx max err |",
+-        "| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
+-    ]
+-    for item in results:
+-        lat = item["latency_ms"]
+-        error = item["torch_vs_onnx_max_abs_error"]
+-        error_text = "" if error is None else f"{error:.3e}"
+-        rss = item["rss_delta_mb"]
+-        rss_text = "" if rss is None else f"{rss:.2f}"
+-        lines.append(
+-            f"| {item['id']} | {item['file_size_mb']:.2f} | {item['initializer_params']} | "
+-            f"{lat['mean']:.4f} | {lat['p50']:.4f} | {lat['p95']:.4f} | {lat['p99']:.4f} | "
+-            f"{lat['max']:.4f} | {rss_text} | {error_text} |"
+-        )
+-    output_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+-
+-
+-def main() -> None:
+-    parser = argparse.ArgumentParser(description="Benchmark fixed V14 flat ONNX actors on CPU.")
+-    parser.add_argument("--manifest", default=str(BENCH_DIR / "manifest.yaml"))
+-    parser.add_argument("--warmup", type=int, default=None)
+-    parser.add_argument("--iterations", type=int, default=None)
+-    parser.add_argument("--batch", type=int, default=None)
+-    parser.add_argument("--seed", type=int, default=1234)
+-    args = parser.parse_args()
+-
+-    manifest_path = Path(args.manifest)
+-    manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
+-    warmup = int(args.warmup or manifest.get("warmup", 1000))
+-    iterations = int(args.iterations or manifest.get("iterations", 10000))
+-    batch = int(args.batch or manifest.get("batch_size", 1))
+-    results = []
+-    for model in manifest["models"]:
+-        path = BENCH_DIR / model["path"]
+-        if not path.exists():
+-            results.append({"id": model["id"], "path": str(path), "error": "missing model"})
+-            continue
+-        results.append(_run_model(model["id"], path, warmup, iterations, batch, args.seed))
+-
+-    reports_dir = BENCH_DIR / "reports"
+-    reports_dir.mkdir(parents=True, exist_ok=True)
+-    json_path = reports_dir / "benchmark_cpu.json"
+-    md_path = reports_dir / "benchmark_cpu.md"
+-    json_path.write_text(json.dumps(results, indent=2), encoding="utf-8")
+-    _write_markdown([item for item in results if "error" not in item], md_path)
+-    print(f"Wrote {json_path}")
+-    print(f"Wrote {md_path}")
+-
+-
+-if __name__ == "__main__":
+-    main()
