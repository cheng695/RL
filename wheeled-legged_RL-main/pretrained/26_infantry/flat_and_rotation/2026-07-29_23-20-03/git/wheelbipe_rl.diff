+-def run_git(git_root: Path, *args: str) -> subprocess.CompletedProcess[str]:
+-    return subprocess.run(
+-        ["git", "-C", str(git_root), *args],
+-        check=True,
+-        stdout=subprocess.PIPE,
+-        stderr=subprocess.PIPE,
+-        text=True,
+-    )
+-
+-
+-def auto_commit_run(repo_root: Path, run_dir: Path) -> GitCommitResult:
+-    result = GitCommitResult(
+-        enabled=True,
+-        attempted=False,
+-        committed=False,
+-        message=f"papers: add research run {run_dir.name}",
+-    )
+-    try:
+-        git_root = Path(run_git(repo_root, "rev-parse", "--show-toplevel").stdout.strip())
+-    except subprocess.CalledProcessError as exc:
+-        result.error = (exc.stderr or exc.stdout or "git repository not found").strip()
+-        return result
+-
+-    try:
+-        rel_run_dir = run_dir.relative_to(git_root)
+-    except ValueError:
+-        result.error = f"run directory {run_dir} is outside git repo {git_root}"
+-        return result
+-
+-    rel_run_dir_str = rel_run_dir.as_posix()
+-    try:
+-        run_git(git_root, "add", "-A", "--", rel_run_dir_str)
+-        result.attempted = True
+-        diff_proc = subprocess.run(
+-            ["git", "-C", str(git_root), "diff", "--cached", "--quiet", "--", rel_run_dir_str],
+-            check=False,
+-            stdout=subprocess.PIPE,
+-            stderr=subprocess.PIPE,
+-            text=True,
+-        )
+-        if diff_proc.returncode == 0:
+-            result.error = "no staged changes found for generated run directory"
+-            return result
+-        if diff_proc.returncode != 1:
+-            result.error = (diff_proc.stderr or diff_proc.stdout or "failed to inspect staged changes").strip()
+-            return result
+-
+-        commit_proc = run_git(git_root, "commit", "--only", "-m", result.message or "", "--", rel_run_dir_str)
+-        _ = commit_proc
+-        result.committed = True
+-        result.commit_sha = run_git(git_root, "rev-parse", "HEAD").stdout.strip()
+-        return result
+-    except subprocess.CalledProcessError as exc:
+-        result.error = (exc.stderr or exc.stdout or str(exc)).strip()
+-        return result
+-
