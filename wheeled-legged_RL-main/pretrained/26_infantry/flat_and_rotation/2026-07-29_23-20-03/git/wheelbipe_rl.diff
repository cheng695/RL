+-    "title": "GNM: A General Navigation Model to Drive Any Robot",
+-    "openalex_id": "https://openalex.org/W4304192735",
+-    "relevance_score": 3.6850011,
+-    "publication_date": "2022-10-07",
+-    "publication_year": 2022,
