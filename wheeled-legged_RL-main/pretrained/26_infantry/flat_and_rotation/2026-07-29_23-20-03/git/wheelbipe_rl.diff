+-+        sphere_geom_start = gymutil.WireframeSphereGeometry(0.02, 4, 4, None, color=(0, 1, 0))
+-+
+-+        for i in range(self.num_envs):
+-+            goal_pos = (self.init_state[i, :3] + self.commands[i,0:3]).cpu().numpy()
+-+            goal_pos[2] = 0
