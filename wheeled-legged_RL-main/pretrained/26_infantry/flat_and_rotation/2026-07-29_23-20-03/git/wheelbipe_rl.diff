++        lower = float(getattr(env.cfg, "rear2_rear1_joint_limit_lower", -3.0 / 180.0 * torch.pi))
++        upper = float(getattr(env.cfg, "rear2_rear1_joint_limit_upper", 60.0 / 180.0 * torch.pi))
++        lower, upper = min(lower, upper), max(lower, upper)
