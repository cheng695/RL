+-#!/usr/bin/env python3
+-"""Check whether a recorded play video contains non-black rendered frames."""
+-
+-from __future__ import annotations
+-
+-import argparse
+-import json
+-from pathlib import Path
+-
+-import cv2
+-import numpy as np
+-
+-
+-def _sample_indices(frame_count: int, sample_frames: int) -> list[int]:
+-    if frame_count <= 0:
+-        return [0]
+-    sample_frames = max(1, min(sample_frames, frame_count))
+-    return sorted({int(x) for x in np.linspace(0, frame_count - 1, sample_frames)})
+-
+-
+-def main() -> int:
+-    parser = argparse.ArgumentParser(description="Validate that a play video is not blank/black.")
+-    parser.add_argument("video", type=Path, help="Video file to inspect.")
+-    parser.add_argument("--sample_frames", type=int, default=12, help="Number of frames to sample.")
+-    parser.add_argument("--min_mean", type=float, default=3.0, help="Minimum max grayscale mean to pass.")
+-    parser.add_argument("--min_std", type=float, default=1.0, help="Minimum max grayscale stddev to pass.")
+-    args = parser.parse_args()
+-
+-    if not args.video.exists():
+-        print(json.dumps({"status": "failed", "reason": "missing_video", "video": str(args.video)}, ensure_ascii=False))
+-        return 2
+-
+-    cap = cv2.VideoCapture(str(args.video))
+-    if not cap.isOpened():
+-        print(json.dumps({"status": "failed", "reason": "cannot_open_video", "video": str(args.video)}, ensure_ascii=False))
+-        return 2
+-
+-    frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
+-    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH) or 0)
+-    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT) or 0)
+-    fps = float(cap.get(cv2.CAP_PROP_FPS) or 0.0)
+-
+-    means: list[float] = []
+-    stds: list[float] = []
+-    read_frames = 0
+-    for idx in _sample_indices(frame_count, args.sample_frames):
+-        cap.set(cv2.CAP_PROP_POS_FRAMES, idx)
+-        ok, frame = cap.read()
+-        if not ok or frame is None:
+-            continue
+-        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+-        means.append(float(gray.mean()))
+-        stds.append(float(gray.std()))
+-        read_frames += 1
+-    cap.release()
+-
+-    max_mean = max(means) if means else 0.0
+-    max_std = max(stds) if stds else 0.0
+-    passed = read_frames > 0 and width > 0 and height > 0 and max_mean >= args.min_mean and max_std >= args.min_std
+-    result = {
+-        "status": "passed" if passed else "failed",
+-        "video": str(args.video),
+-        "frame_count": frame_count,
+-        "read_frames": read_frames,
+-        "width": width,
+-        "height": height,
+-        "fps": fps,
+-        "max_gray_mean": max_mean,
+-        "max_gray_std": max_std,
+-        "thresholds": {"min_mean": args.min_mean, "min_std": args.min_std},
+-    }
+-    print(json.dumps(result, ensure_ascii=False, indent=2))
+-    return 0 if passed else 3
+-
+-
+-if __name__ == "__main__":
+-    raise SystemExit(main())
