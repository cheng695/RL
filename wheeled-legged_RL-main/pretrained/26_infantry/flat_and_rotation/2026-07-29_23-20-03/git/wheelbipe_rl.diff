+-def rank_candidates(
+-    candidates: list[PaperCandidate],
+-    max_papers: int,
+-    *,
+-    topic: str,
+-    repo_keywords: list[str],
+-    recent_years: float,
+-    strict_recent_window: bool,
+-) -> list[PaperCandidate]:
+-    if not candidates:
+-        return []
+-    anchor_groups = enrich_topic_matches(candidates=candidates, topic=topic, repo_keywords=repo_keywords)
+-    min_match_groups = 2 if len(anchor_groups) >= 3 else 1
+-    required_groups = {"robotics"}
+-    if "locomotion" in anchor_groups:
+-        required_groups.add("locomotion")
+-    filtered_candidates = [
+-        candidate
+-        for candidate in candidates
+-        if required_groups.issubset(set(candidate.topic_matches)) and len(candidate.topic_matches) >= min_match_groups
+-    ]
+-    if len(filtered_candidates) < max_papers:
+-        filtered_candidates = [
+-            candidate
+-            for candidate in candidates
+-            if required_groups.issubset(set(candidate.topic_matches)) or "locomotion" in candidate.topic_matches
+-        ] or candidates
+-    now = datetime.now(UTC)
+-    max_citations = max(candidate.cited_by_count for candidate in filtered_candidates) or 1
+-    max_relevance = max(candidate.relevance_score for candidate in filtered_candidates) or 1.0
+-    max_match_groups = max(len(candidate.topic_matches) for candidate in filtered_candidates) or 1
+-    recent_cutoff_days = int(recent_years * 365.25)
+-    for candidate in filtered_candidates:
+-        published_dt = iso_to_datetime(candidate.publication_date)
+-        age_days = max((now - published_dt).days, 1) if published_dt else 3650
+-        age_years = age_days / 365.25
+-        recency_score = 1.0 / (1.0 + age_days / 365.25)
+-        citation_score = math.log1p(candidate.cited_by_count) / math.log1p(max_citations)
+-        relevance_score = candidate.relevance_score / max_relevance
+-        hot_score = min(1.0, candidate.cited_by_count / max(age_years, 0.35) / 80.0)
+-        classic_score = 0.0
+-        if age_years >= 2.0:
+-            classic_score = min(1.0, candidate.cited_by_count / 120.0) * min(1.0, age_years / 5.0)
+-        topic_match_score = len(candidate.topic_matches) / max_match_groups
+-        candidate.scores = {
+-            "recency": round(recency_score, 4),
+-            "citation": round(citation_score, 4),
+-            "relevance": round(relevance_score, 4),
+-            "hot": round(hot_score, 4),
+-            "classic": round(classic_score, 4),
+-            "topic_match": round(topic_match_score, 4),
+-            "is_recent": 1.0 if age_days <= recent_cutoff_days else 0.0,
+-            "blog_proxy": -1,
+-        }
+-    recent_candidates = [item for item in filtered_candidates if item.scores["is_recent"] >= 1.0]
+-    if strict_recent_window:
+-        ranking_pool = recent_candidates
+-    else:
+-        ranking_pool = recent_candidates if recent_candidates else filtered_candidates
+-    overall_ranked = sorted(
+-        ranking_pool,
+-        key=lambda item: (
+-            0.45 * item.scores["recency"]
+-            + 0.25 * item.scores["topic_match"]
+-            + 0.20 * item.scores["relevance"]
+-            + 0.10 * item.scores["citation"]
+-        ),
+-        reverse=True,
+-    )
+-
+-    selected: list[PaperCandidate] = []
+-    for item in overall_ranked:
+-        if len(selected) >= max_papers:
+-            break
+-        if item.scores["relevance"] < 0.05 or item.scores["topic_match"] <= 0.0:
+-            continue
+-        if item.scores["is_recent"] >= 1.0:
+-            item.selection_tags.append("recent")
+-            item.selection_reasons.append(f"发布时间落在优先窗口内（近 {recent_years:g} 年）。")
+-        else:
+-            item.selection_tags.append("fallback-older")
+-            item.selection_reasons.append(f"由于近 {recent_years:g} 年候选不足，作为较旧但仍相关的补充论文保留。")
+-        if item.cited_by_count >= 20:
+-            item.selection_tags.append("recent-hot")
+-            item.selection_reasons.append("在近年候选里属于相对更有讨论度 / 被引更高的工作。")
+-        if item.topic_matches:
+-            item.selection_reasons.append(f"命中主题锚点: {', '.join(item.topic_matches)}。")
+-        selected.append(item)
+-    if not strict_recent_window and len(selected) < max_papers:
+-        selected_ids = {item.arxiv_id or item.openalex_id for item in selected}
+-        backfill_ranked = sorted(
+-            filtered_candidates,
+-            key=lambda item: (
+-                item.scores.get("recency", 0.0),
+-                item.scores.get("topic_match", 0.0),
+-                item.scores.get("relevance", 0.0),
+-                item.scores.get("citation", 0.0),
+-            ),
+-            reverse=True,
+-        )
+-        for item in backfill_ranked:
+-            if len(selected) >= max_papers:
+-                break
+-            item_id = item.arxiv_id or item.openalex_id
+-            if item_id in selected_ids:
+-                continue
+-            item.selection_tags.append("backfill")
+-            item.selection_reasons.append("用于补足 10 篇的主题相关回填论文。")
+-            if item.topic_matches:
+-                item.selection_reasons.append(f"命中主题锚点: {', '.join(item.topic_matches)}。")
+-            selected.append(item)
+-            selected_ids.add(item_id)
+-    return selected[:max_papers]
+-
