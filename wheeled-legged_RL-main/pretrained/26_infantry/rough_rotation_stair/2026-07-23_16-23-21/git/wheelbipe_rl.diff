+  canvas.height = Math.floor(canvas.clientHeight * devicePixelRatio);
+  draw();
+}}
+function selectedRows() {{ return rows.filter(r => r.sim_time_s >= xMin && r.sim_time_s <= xMax); }}
+function yRange(rs) {{
+  let vals = [];
+  for (const r of rs) for (const k of Object.keys(visible)) if (visible[k]) vals.push(r[k]);
+  if (!vals.length) return [-1, 1];
+  let lo = Math.min(...vals), hi = Math.max(...vals);
+  if (Math.abs(hi - lo) < 1e-6) {{ lo -= 1; hi += 1; }}
+  const pad = 0.08 * (hi - lo);
+  return [lo - pad, hi + pad];
+}}
+function draw() {{
+  const w = canvas.width, h = canvas.height;
+  ctx.clearRect(0, 0, w, h);
+  const padL = 62 * devicePixelRatio, padR = 18 * devicePixelRatio, padT = 18 * devicePixelRatio, padB = 42 * devicePixelRatio;
+  const pw = w - padL - padR, ph = h - padT - padB;
+  ctx.fillStyle = "#fff"; ctx.fillRect(0,0,w,h);
+  const rs = selectedRows();
+  const [yMin, yMax] = yRange(rs);
+  const sx = x => padL + (x - xMin) / Math.max(xMax - xMin, 1e-9) * pw;
+  const sy = y => padT + (yMax - y) / Math.max(yMax - yMin, 1e-9) * ph;
+  ctx.strokeStyle = "#ddd"; ctx.lineWidth = 1 * devicePixelRatio;
+  ctx.beginPath(); ctx.rect(padL, padT, pw, ph); ctx.stroke();
+  ctx.fillStyle = "#555"; ctx.font = `${{12 * devicePixelRatio}}px Arial`;
+  for (let i=0;i<=5;i++) {{
+    const y = yMin + (yMax-yMin)*i/5;
