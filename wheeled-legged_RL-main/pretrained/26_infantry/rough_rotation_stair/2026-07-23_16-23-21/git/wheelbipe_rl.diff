+const colors = {{cmd_x:"#d73027", vel_x_b:"#4575b4", cmd_yaw:"#fdae61", yaw_rate_b:"#1a9850"}};
+let visible = {{cmd_x:true, vel_x_b:true, cmd_yaw:true, yaw_rate_b:true}};
